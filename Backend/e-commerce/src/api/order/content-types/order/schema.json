{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "required": true
    },
    "companyName": {
      "type": "string"
    },
    "streetAddress": {
      "type": "string",
      "required": true
    },
    "apartment": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "required": true
    },
    "phoneNumber": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "paymentMethod": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "bank",
        "cod"
      ]
    },
    "totalPrice": {
      "type": "decimal",
      "required": true
    },
    "clerkUserId": {
      "type": "string",
      "required": true
    },
    "orderItems": {
      "type": "json",
      "required": true
    }
  }
}
